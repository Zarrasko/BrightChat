<?xml version="1.0" encoding="utf-8"?>
<!-- Maps the cacheDir/shared/ folder (where openAttachment downloads files) to the
     FileProvider so a content:// URI can be granted to an external viewer/share app. -->
<paths>
    <cache-path name="shared" path="shared/" />
    <!-- Where the camera app is asked to write a photo taken from the picker. -->
    <cache-path name="camera" path="camera/" />
    <!-- A downloaded update APK, handed to the system installer. See Updater.kt. -->
    <cache-path name="updates" path="updates/" />
</paths>
